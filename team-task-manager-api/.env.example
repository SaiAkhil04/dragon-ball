# Copy this file to .env and replace the example secret before running.
DATABASE_URL=sqlite:///./task_manager.db
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
JWT_EXPIRE_MINUTES=60
# Used only by the optional admin seeding command. Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-admin-password
